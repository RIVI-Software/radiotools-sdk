{
  "name": "radiotools-sdk-monorepo",
  "private": true,
  "description": "RadioTools customer SDKs and generators",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "bun run --filter @rivi-software/radiotools-sdk test",
    "generate": "bun run --filter @rivi-software/radiotools-sdk-generator generate --target all",
    "build": "bun run --filter @rivi-software/radiotools-sdk-generator build",
    "postinstall": "bun run --filter @rivi-software/radiotools-sdk-generator build",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install",
    "release-packages": "bun run generate && bun run build && bun run check && bun test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.2",
    "@types/bun": "1.2.23",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
