{
  "name": "radiotools-sdk-monorepo",
  "private": true,
  "description": "RadioTools customer SDKs and generators",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun run --filter '*' check",
    "test": "bun run --filter @radiotools/sdk test",
    "generate": "bun run --filter @radiotools/sdk-generator generate --target all",
    "build": "bun run --filter @radiotools/sdk-generator build",
    "postinstall": "bun run --filter @radiotools/sdk-generator build"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
